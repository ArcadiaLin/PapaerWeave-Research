# Local reference material. Track source metadata, not binaries or full clones.
/references/papers/
/references/repos/
/references/datasets/

# External data, model weights, and caches.
# data/ 整体暂不进入版本管理（2026-10-11），包括 e08 种子、e09 入库文档与 T1 先导语料；均只保留本地副本。
/data/
/models/
/checkpoints/
/cache/
# packages/arxiv2md 抓取的 arXiv HTML 缓存（默认 cwd 下，可用 ARXIV2MD_CACHE_PATH 改）
.arxiv2md_cache/

# Generated experiment output. Keep experiment code and configs under experiments/ tracked.
/runs/
/results/
/tmps/

# 项目级 agent skills：nature-figure 只在本地使用，不进版本管理（其余 skill 仍跟踪）。
/.agents/skills/nature-figure/

# Per-config pi conversation history.
/pi-configs/*/sessions/

# Per-config pi agent dir (symlinks to local credentials, generated caches).
# Each config's own models.json stays tracked.
/pi-configs/*/agent/*
!/pi-configs/*/agent/models.json

# Node.js dependencies, build output, and profiling artifacts.
node_modules/
dist/
coverage/
.npm/
*.tsbuildinfo
*.cpuprofile
/outputs/
/artifacts/
/wandb/
/mlruns/
/scratch/

# Secrets and machine-local configuration.
.env
.env.*
!.env.example

# Python environments, bytecode, test, type-checker, and build caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Jupyter. 提交的 notebook 由 nbstripout 剥掉 cell 输出（见 .gitattributes），
# 所以 .ipynb 本身是跟踪的 —— 剥输出是为了 diff 可读，**不是**实验日志的载体。
# 日志载体是 data/processed/ 下带 _provenance 的产物加 docs/experiments/ 的记录。
# 某次运行本身值得被引用时，显式导出到 <experiment>/notebooks/runs/ 并提交；
# 该目录不在根 /runs/ 的忽略范围内（那条带前导斜杠，只匹配仓库根）。
.ipynb_checkpoints/
*-checkpoint.ipynb

# Editors and operating-system noise.
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files.
*.log
*.tmp
*.swp
*~

# notebook 旁的探索产物：只是 notebook 跑出来的中间结果，不是流水线工件
# （流水线工件在 data/processed/，带 _provenance）。
experiments/*/notebooks/_scratch/
system/notebooks/_scratch/
eval/notebooks/_scratch/

# neo4j infra

infra/neo4j/data/
infra/neo4j/logs/
infra/neo4j/plugins/
infra/neo4j-e08/data/
infra/neo4j-e08/logs/
infra/neo4j-e08/plugins/
infra/neo4j-e08/backups/
infra/neo4j-e09/data/
infra/neo4j-e09/logs/
infra/neo4j-e09/backups/
infra/neo4j-t1/data/
infra/neo4j-t1/logs/
